{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xtnd-mcp-one",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "one.mcp.xgi.io",
      "custom_domain": true
    },
    {
      "pattern": "mcp-one.xgi.io",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  // xtnd-mcp-one#2. API_KEYS is mcp-one's own namespace. It has no id on
  // purpose: the first CI deploy creates it ("xtnd-mcp-one-api-keys") and every
  // deploy after reuses the one the deployed Worker is bound to. It must keep
  // this binding name: a binding without an id takes over whatever namespace the
  // deployed Worker already has under the same name.
  // XMAIL_KEYS is xtnd-xmail-api's namespace, read only during the transition;
  // step 2 removes it, by 20 Nov 2026.
  "kv_namespaces": [
    {
      "binding": "API_KEYS"
    },
    {
      "binding": "XMAIL_KEYS",
      "id": "12eb8b74953c4e7b8483107fd2158932"
    }
  ],
  "vars": {
    "ONECOM_IMAP_HOST": "imap.one.com",
    "ONECOM_IMAP_PORT": "993",
    "ONECOM_SMTP_HOST": "send.one.com",
    "ONECOM_SMTP_PORT": "465"
  },
  "env": {
    "dev": {
      "workers_dev": true,
      "routes": [],
      // Its own namespace, created on the dev Worker's first deploy
      // ("xtnd-mcp-one-dev-api-keys"). No XMAIL_KEYS: xtnd-xmail-api-dev has no
      // KV namespace, so there is no XMail dev key to accept.
      "kv_namespaces": [
        {
          "binding": "API_KEYS"
        }
      ],
      "vars": {
        "ONECOM_IMAP_HOST": "imap.one.com",
        "ONECOM_IMAP_PORT": "993",
        "ONECOM_SMTP_HOST": "send.one.com",
        "ONECOM_SMTP_PORT": "465"
      }
    }
  }
}
