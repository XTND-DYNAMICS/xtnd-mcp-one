{
  "name": "@xtnd-dynamics/mcp-one",
  "version": "0.1.4",
  "description": "Model Context Protocol (MCP) server for one.com mailboxes. Full email management (IMAP/SMTP) for Claude and AI agents.",
  "license": "MIT",
  "author": "XTND Dynamics",
  "homepage": "https://github.com/XTND-DYNAMICS/xtnd-mcp-one#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/XTND-DYNAMICS/xtnd-mcp-one.git"
  },
  "bugs": {
    "url": "https://github.com/XTND-DYNAMICS/xtnd-mcp-one/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "email",
    "one.com",
    "imap",
    "smtp",
    "ai-agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-one": "./dist/cli.js",
    "xtnd-mcp-one": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "smithery.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "test": "tsx --test test/*.test.ts",
    "test:stdio": "tsx scripts/test-local-stdio.ts",
    "test:hosted": "tsx scripts/test-hosted-saas.ts",
    "test:streamable": "tsx scripts/test-streamable-http.ts",
    "test:live": "tsx scripts/test-local-stdio.ts && tsx scripts/test-hosted-saas.ts && tsx scripts/test-streamable-http.ts",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "worker-mailer": "^1.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.2"
  }
}
