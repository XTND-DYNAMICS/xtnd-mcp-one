{
  "name": "@xtnd/mcp-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "xtnd-mcp-one": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "test:stdio": "tsx scripts/test-local-stdio.ts",
    "test:hosted": "tsx scripts/test-hosted-saas.ts",
    "test:live": "tsx scripts/test-local-stdio.ts && tsx scripts/test-hosted-saas.ts",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "worker-mailer": "^1.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.2"
  }
}
